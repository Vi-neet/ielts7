rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        request.auth.token.email in ['meenunarula1104@gmail.com', 'varunsaxena5elc@gmail.com', 'hnarula55@gmail.com', 'gobounce252@gmail.com']
      );
    }

    match /attempts/{attemptId} {
      allow read: if resource.data.uid == request.auth.uid || isAdmin();
      allow create: if (request.resource.data.uid == request.auth.uid)
        || (request.resource.data.uid == null
            && request.resource.data.isGuest == true);
      allow update, delete: if false;
    }
    match /users/{userId} {
      allow read: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if isAdmin() || (
        request.auth != null && request.auth.uid == userId
        && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)
      );
      allow delete: if isAdmin();
    }
    match /writingSubmissions/{submissionId} {
      allow read: if (request.auth != null && resource.data.uid == request.auth.uid) || isAdmin();
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.taskType in ['task_1', 'task_2']
        && request.resource.data.submissionMethod in ['text', 'file']
        && request.resource.data.status == 'submitted'
        && request.resource.data.submittedAt == request.time
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.notes == null || request.resource.data.notes is string)
        && request.resource.data.keys().hasOnly(['uid', 'taskType', 'submissionMethod', 'essayText', 'storagePath', 'fileName', 'fileSize', 'wordCount', 'notes', 'status', 'submittedAt', 'updatedAt'])
        && (
          (request.resource.data.submissionMethod == 'text'
            && request.resource.data.essayText is string && request.resource.data.essayText != ''
            && request.resource.data.storagePath == null
            && request.resource.data.fileName == null
            && request.resource.data.fileSize == null
            && (request.resource.data.wordCount is int && request.resource.data.wordCount >= 0))
          ||
          (request.resource.data.submissionMethod == 'file'
            && request.resource.data.essayText == null
            && request.resource.data.storagePath is string && request.resource.data.storagePath != ''
            && request.resource.data.fileName is string && request.resource.data.fileName != ''
            && request.resource.data.fileSize is int && request.resource.data.fileSize > 0 && request.resource.data.fileSize <= 5242880
            && request.resource.data.wordCount == null)
        );
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Public read-only access for listening test material
    match /{collectionId}/{docId} {
      allow read: if collectionId.matches('cambridge_[0-9]+_listening');
    }

    // Speaking Practice Slots (admin-managed available time slots)
    match /speakingSlots/{slotId} {
      // Anyone can view available speaking slots
      allow read: if true;
      // Admins can create and delete slots
      allow create, delete: if isAdmin();
      // Admins can update any slot; candidates reserving a slot can mark it as booked (isAvailable = false)
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isAvailable', 'bookedBy', 'updatedAt']) &&
        request.resource.data.isAvailable == false
      );
    }

    // Speaking Practice Bookings (student session reservations)
    match /speakingBookings/{bookingId} {
      // Admins or the candidate owner can read their booking
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      // Anyone can submit a booking reservation
      allow create: if true;
      // Admins or the candidate owner can update or cancel their booking
      allow update, delete: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
    }

    // System Config (speaking settings, default meeting link)
    match /systemConfig/{configId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
